; Cyclops Image Browser installer (Inno Setup 6). Built by installer\build.ps1, which stages the
; files in target\package and passes the version: ISCC /DAppVersion=1.0.0 installer\cyclops.iss

#ifndef AppVersion
  #define AppVersion "0.0.0"
#endif
#define Package "..\target\package"

[Setup]
AppId={{7C1E2B6A-3F4D-4E8B-9A51-C0D2F3E4A5B6}
AppName=Cyclops Image Browser
AppVersion={#AppVersion}
AppVerName=Cyclops Image Browser {#AppVersion}
AppPublisher=Martin Vestergaard Madsen
VersionInfoVersion={#AppVersion}
; Per-user by default (no administrator rights needed); the user can choose all users instead.
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
DefaultDirName={autopf}\Cyclops
DefaultGroupName=Cyclops
DisableProgramGroupPage=yes
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0.17763
SetupIconFile=..\assets\cyclops.ico
UninstallDisplayIcon={app}\cyclops.exe
UninstallDisplayName=Cyclops Image Browser
WizardStyle=modern
Compression=lzma2/ultra64
SolidCompression=yes
OutputDir=..\dist
OutputBaseFilename=Cyclops-{#AppVersion}-setup
CloseApplications=yes
ChangesAssociations=yes

[Tasks]
Name: "desktopicon"; Description: "Create a &desktop shortcut"; GroupDescription: "Shortcuts:"; Flags: unchecked
Name: "openwith"; Description: "Add Cyclops to Explorer's ""Open with"" menu for images (doesn't change your default viewer)"; GroupDescription: "Integration:"

[Files]
Source: "{#Package}\cyclops.exe"; DestDir: "{app}"; Flags: ignoreversion
; Visual C++ runtime, deployed next to the exe so no separate redistributable is needed.
Source: "{#Package}\*.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#Package}\licenses\*"; DestDir: "{app}\licenses"; Flags: ignoreversion recursesubdirs

[Icons]
Name: "{autoprograms}\Cyclops Image Browser"; Filename: "{app}\cyclops.exe"
Name: "{autodesktop}\Cyclops Image Browser"; Filename: "{app}\cyclops.exe"; Tasks: desktopicon

[Registry]
; "Open with" registration: an application entry plus OpenWithProgids for each image type.
Root: HKA; Subkey: "Software\Classes\Applications\cyclops.exe"; ValueType: string; ValueName: "FriendlyAppName"; ValueData: "Cyclops Image Browser"; Flags: uninsdeletekey; Tasks: openwith
Root: HKA; Subkey: "Software\Classes\Applications\cyclops.exe\shell\open\command"; ValueType: string; ValueData: """{app}\cyclops.exe"" ""%1"""; Tasks: openwith
Root: HKA; Subkey: "Software\Classes\Cyclops.Image"; ValueType: string; ValueData: "Image (Cyclops)"; Flags: uninsdeletekey; Tasks: openwith
Root: HKA; Subkey: "Software\Classes\Cyclops.Image\DefaultIcon"; ValueType: string; ValueData: "{app}\cyclops.exe,0"; Tasks: openwith
Root: HKA; Subkey: "Software\Classes\Cyclops.Image\shell\open\command"; ValueType: string; ValueData: """{app}\cyclops.exe"" ""%1"""; Tasks: openwith
; One OpenWithProgids + SupportedTypes pair per image extension, generated by build.ps1.
#include Package + "\openwith.iss"

[Run]
Filename: "{app}\cyclops.exe"; Description: "Launch Cyclops Image Browser"; Flags: nowait postinstall skipifsilent
